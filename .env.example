# ── Backend ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection (Session mode, port 5432 or Transaction mode, port 6543)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=your-database-password

# Supabase project
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_API_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME=socialMediaApp

# JWT signing secret (base64-encoded, min 64 bytes recommended)
JWT_SECRET=your-jwt-secret-key

# ── Frontend (baked into the JS bundle at build time) ─────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GEMINI_API_KEY=your-google-gemini-api-key
VITE_API_BASE_URL=http://localhost:8080/api
